<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==========================================================
         Decision History Report
    =========================================================== -->

    <record id="action_report_decision_history"
            model="ir.actions.report">

        <field name="name">
            Decision History
        </field>

        <field name="model">
            club.review
        </field>

        <field name="report_type">
            qweb-pdf
        </field>

        <field name="report_name">
            club_committee.report_decision_history
        </field>

        <field name="report_file">
            club_committee.report_decision_history
        </field>

        <field name="binding_model_id"
               ref="model_club_review"/>

        <field name="binding_type">
            report
        </field>

        <field name="paperformat_id"
               ref="club_committee.paperformat_club_committee"/>

        <field name="print_report_name">

            'Decision History - %s' % (
                object.review_number or ''
            )

        </field>

    </record>

</odoo>