<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==========================================================
         Committee Review Report
    =========================================================== -->

    <record id="action_report_committee_review"
            model="ir.actions.report">

        <field name="name">
            Committee Review
        </field>

        <field name="model">
            club.review
        </field>

        <field name="report_type">
            qweb-pdf
        </field>

        <field name="report_name">
            club_committee.report_committee_review
        </field>

        <field name="report_file">
            club_committee.report_committee_review
        </field>

        <field name="print_report_name">

            'Committee Review - %s' % (object.review_number)

        </field>

        <field name="binding_model_id"
               ref="model_club_review"/>

        <field name="binding_type">
            report
        </field>

    </record>

</odoo>