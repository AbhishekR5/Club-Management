<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==========================================================
         Approval Statistics Report Template
    =========================================================== -->

    <template id="report_approval_statistics">

        <t t-call="web.html_container">

            <t t-call="web.external_layout">

                <div class="page">

                    <!-- ======================================
                         Report Header
                    ======================================= -->

                    <div class="text-center mb-4">

                        <h2>
                            Membership Approval Statistics
                        </h2>

                        <p>

                            Generated On :

                            <strong>

                                <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>

                            </strong>

                        </p>

                        <p>

                            Generated By :

                            <strong>

                                <span t-out="user.name"/>

                            </strong>

                        </p>

                    </div>

                    <!-- ======================================
                         KPI Summary
                    ======================================= -->

                    <h3>Key Performance Indicators</h3>

                    <table class="table table-bordered">

                        <thead>

                            <tr class="table-active">

                                <th>Total Reviews</th>

                                <th>Approved</th>

                                <th>Rejected</th>

                                <th>Returned</th>

                                <th>Pending</th>

                                <th>Approval %</th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td class="text-center">

                                    <span t-out="total_reviews"/>

                                </td>

                                <td class="text-center">

                                    <span t-out="approved_reviews"/>

                                </td>

                                <td class="text-center">

                                    <span t-out="rejected_reviews"/>

                                </td>

                                <td class="text-center">

                                    <span t-out="returned_reviews"/>

                                </td>

                                <td class="text-center">

                                    <span t-out="pending_reviews"/>

                                </td>

                                <td class="text-center">

                                    <strong>

                                        <span t-out="'%.2f %%' % approval_percentage"/>

                                    </strong>

                                </td>

                            </tr>

                        </tbody>

                    </table>


                    <!-- ======================================
                         Committee Statistics
                    ======================================= -->

                    <h3>Committee Statistics</h3>

                    <table class="table table-sm table-bordered">

                        <thead>

                            <tr class="table-active">

                                <th>Committee</th>

                                <th>Total</th>

                                <th>Approved</th>

                                <th>Rejected</th>

                                <th>Returned</th>

                                <th>Pending</th>

                                <th>Approval %</th>

                            </tr>

                        </thead>

                        <tbody>

                            <t t-foreach="committee_statistics"
                               t-as="committee">

                                <tr>

                                    <td>

                                        <span t-out="committee['name']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="committee['total']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="committee['approved']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="committee['rejected']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="committee['returned']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="committee['pending']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="'%.2f %%' % committee['percentage']"/>

                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <!-- ======================================
                         Reviewer Performance
                    ======================================= -->

                    <h3>Reviewer Performance</h3>

                    <table class="table table-sm table-bordered">

                        <thead>

                            <tr class="table-active">

                                <th>Reviewer</th>

                                <th>Total Reviews</th>

                                <th>Approved</th>

                                <th>Rejected</th>

                                <th>Average Score</th>

                            </tr>

                        </thead>

                        <tbody>

                            <t t-foreach="reviewer_statistics"
                               t-as="reviewer">

                                <tr>

                                    <td>

                                        <span t-out="reviewer['name']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="reviewer['total']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="reviewer['approved']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="reviewer['rejected']"/>

                                    </td>

                                    <td class="text-center">

                                        <span t-out="'%.2f' % reviewer['average_score']"/>

                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <!-- ======================================
                         Status Distribution
                    ======================================= -->

                    <h3>Status Distribution</h3>

                    <table class="table table-sm table-bordered">

                        <thead>

                            <tr class="table-active">

                                <th>Status</th>

                                <th>Count</th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>Draft</td>

                                <td class="text-center">
                                    <span t-out="draft_reviews"/>
                                </td>

                            </tr>

                            <tr>

                                <td>Scheduled</td>

                                <td class="text-center">
                                    <span t-out="scheduled_reviews"/>
                                </td>

                            </tr>

                            <tr>

                                <td>Interview Completed</td>

                                <td class="text-center">
                                    <span t-out="completed_reviews"/>
                                </td>

                            </tr>

                            <tr>

                                <td>Under Review</td>

                                <td class="text-center">
                                    <span t-out="under_review_reviews"/>
                                </td>

                            </tr>

                            <tr>

                                <td>Approved</td>

                                <td class="text-center">
                                    <span t-out="approved_reviews"/>
                                </td>

                            </tr>

                            <tr>

                                <td>Rejected</td>

                                <td class="text-center">
                                    <span t-out="rejected_reviews"/>
                                </td>

                            </tr>

                            <tr>

                                <td>Returned</td>

                                <td class="text-center">
                                    <span t-out="returned_reviews"/>
                                </td>

                            </tr>

                        </tbody>

                    </table>


                    <!-- ======================================
                         Report Footer
                    ======================================= -->

                    <br/><br/><br/>

                    <table class="table table-borderless">

                        <tr>

                            <td width="50%"
                                class="text-center">

                                _______________________

                                <br/>

                                Committee Manager

                            </td>

                            <td width="50%"
                                class="text-center">

                                _______________________

                                <br/>

                                General Secretary

                            </td>

                        </tr>

                    </table>

                </div>

            </t>

        </t>

    </template>

</odoo>