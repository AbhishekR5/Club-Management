<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==========================================================
         Decision History Report Template
    =========================================================== -->

    <template id="report_decision_history">

        <t t-call="web.html_container">

            <t t-call="web.external_layout">

                <div class="page">

                    <!-- ======================================
                         Report Header
                    ======================================= -->

                    <div class="text-center mb-4">

                        <h2>
                            Membership Decision History
                        </h2>

                        <p>

                            Generated On :

                            <strong>

                                <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>

                            </strong>

                        </p>

                    </div>

                    <!-- ======================================
                         Decision History Table
                    ======================================= -->

                    <table class="table table-sm table-bordered">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Review No.</th>

                                <th>Applicant</th>

                                <th>Committee</th>

                                <th>Reviewer</th>

                                <th>Decision</th>

                                <th>Status</th>

                                <th>Decision Date</th>

                                <th>Approved By</th>

                            </tr>

                        </thead>

                        <tbody>

                            <t t-set="index" t-value="1"/>

                            <t t-foreach="docs" t-as="o">

                                <tr>

                                    <td>

                                        <span t-out="index"/>

                                    </td>

                                    <td>

                                        <span t-field="o.review_number"/>

                                    </td>

                                    <td>

                                        <span t-field="o.applicant_id"/>

                                    </td>

                                    <td>

                                        <span t-field="o.committee_id"/>

                                    </td>

                                    <td>

                                        <span t-field="o.committee_member_id"/>

                                    </td>

                                    <td>

                                        <span t-field="o.recommendation"/>

                                    </td>

                                    <td>

                                        <span t-field="o.status"/>

                                    </td>

                                    <td>

                                        <span t-field="o.decision_date"/>

                                    </td>

                                    <td>

                                        <span t-field="o.approved_by_id"/>

                                    </td>

                                </tr>

                                <t t-set="index"
                                   t-value="index + 1"/>

                            </t>

                        </tbody>

                    </table>

                    <!-- ======================================
                         Summary
                    ======================================= -->

                    <br/>

                    <table class="table table-sm table-bordered"
                           style="width:45%;">

                        <tbody>

                            <tr>

                                <th>Total Decisions</th>

                                <td class="text-end">

                                    <span t-out="len(docs)"/>

                                </td>

                            </tr>

                            <tr>

                                <th>Generated By</th>

                                <td>

                                    <span t-out="user.name"/>

                                </td>

                            </tr>

                            <tr>

                                <th>Company</th>

                                <td>

                                    <span t-out="company.name"/>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                    <!-- ======================================
                         Signatures
                    ======================================= -->

                    <br/><br/><br/>

                    <table class="table table-borderless">

                        <tr>

                            <td width="50%"
                                class="text-center">

                                _______________________

                                <br/>

                                Committee Chairperson

                            </td>

                            <td width="50%"
                                class="text-center">

                                _______________________

                                <br/>

                                Membership Manager

                            </td>

                        </tr>

                    </table>

                </div>

            </t>

        </t>

    </template>

</odoo>