<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==========================================================
         Membership Review List View
    =========================================================== -->

    <record id="view_club_review_list"
            model="ir.ui.view">

        <field name="name">club.review.list</field>
        <field name="model">club.review</field>

        <field name="arch" type="xml">

            <list
                string="Membership Reviews"
                create="1"
                edit="1"
                delete="0"
                default_order="review_number desc">

                <field name="review_number"/>

                <field name="applicant_id"/>

                <field name="committee_id"/>

                <field name="committee_member_id"/>

                <field name="interview_start"/>

                <field name="meeting_id"/>

                <field name="recommendation"/>

                <field name="status"
                       widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'"
                       decoration-warning="status == 'returned'"
                       decoration-info="status == 'scheduled'"/>

                <field name="score"/>

            </list>

        </field>

    </record>


    <!-- ==========================================================
         Membership Review Kanban View
    =========================================================== -->

    <record id="view_club_review_kanban"
            model="ir.ui.view">

        <field name="name">club.review.kanban</field>

        <field name="model">club.review</field>

        <field name="arch" type="xml">

            <kanban
                class="o_kanban_small_column"
                default_group_by="status">

                <field name="review_number"/>

                <field name="applicant_id"/>

                <field name="committee_id"/>

                <field name="committee_member_id"/>

                <field name="interview_start"/>

                <field name="recommendation"/>

                <field name="status"/>

                <field name="score"/>

                <field name="color"/>

                <templates>

                    <t t-name="card">

                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_color_#{record.color.raw_value}">

                            <!-- Header -->

                            <div class="mb-2">

                                <strong>

                                    <field name="review_number"/>

                                </strong>

                            </div>

                            <!-- Applicant -->

                            <div class="mb-1">

                                <strong>Applicant</strong>

                                <div>

                                    <field name="applicant_id"/>

                                </div>

                            </div>

                            <!-- Committee -->

                            <div class="mb-1">

                                <strong>Committee</strong>

                                <div>

                                    <field name="committee_id"/>

                                </div>

                            </div>

                            <!-- Reviewer -->

                            <div class="mb-1">

                                <strong>Reviewer</strong>

                                <div>

                                    <field name="committee_member_id"/>

                                </div>

                            </div>

                            <!-- Interview -->

                            <div class="mb-1">

                                <strong>Interview</strong>

                                <div>

                                    <field name="interview_start"/>

                                </div>

                            </div>

                            <!-- Recommendation -->

                            <div class="mt-2">

                                <strong>Recommendation</strong>

                                <div>

                                    <field
                                        name="recommendation"
                                        widget="badge"/>

                                </div>

                            </div>

                            <!-- Status -->

                            <div class="mt-2">

                                <field
                                    name="status"
                                    widget="badge"/>

                            </div>

                            <!-- Score -->

                            <div class="mt-2">

                                <strong>Score</strong>

                                <div>

                                    <field name="score"/>

                                </div>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>

    </record>
        <!-- ==========================================================
         Membership Review Form View
    =========================================================== -->

    <record id="view_club_review_form"
            model="ir.ui.view">

        <field name="name">club.review.form</field>

        <field name="model">club.review</field>

        <field name="arch" type="xml">

            <form string="Membership Review">

                <!-- ==========================================
                     Header
                =========================================== -->

                <header>

                    <button
                        name="action_schedule_interview"
                        type="object"
                        string="Schedule Interview"
                        class="btn-primary"
                        invisible="status != 'draft'"/>

                    <button
                        name="action_complete_interview"
                        type="object"
                        string="Complete Interview"
                        class="btn-primary"
                        invisible="status != 'scheduled'"/>

                    <button
                        name="action_under_review"
                        type="object"
                        string="Start Review"
                        class="btn-primary"
                        invisible="status != 'interview_completed'"/>

                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="status != 'under_review'"/>

                    <button
                        name="action_reject"
                        type="object"
                        string="Reject"
                        class="btn-danger"
                        invisible="status != 'under_review'"/>

                    <button
                        name="action_return"
                        type="object"
                        string="Return"
                        class="btn-warning"
                        invisible="status != 'under_review'"/>

                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="status == 'draft'"/>

                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="draft,scheduled,interview_completed,under_review,approved,rejected,returned"/>

                </header>

                <sheet>

                    <!-- ======================================
                         Smart Buttons
                    ======================================= -->

                    <div class="oe_button_box"
                         name="button_box">

                        <button
                            name="action_view_applicant"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-user">

                            <span class="o_stat_text">
                                Applicant
                            </span>

                        </button>

                        <button
                            name="action_view_meeting"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users">

                            <span class="o_stat_text">
                                Meeting
                            </span>

                        </button>

                        <button
                            name="action_view_calendar_event"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar">

                            <span class="o_stat_text">
                                Calendar
                            </span>

                        </button>

                    </div>

                    <!-- ======================================
                         Title
                    ======================================= -->

                    <div class="oe_title">

                        <label for="review_number"/>

                        <h1>

                            <field
                                name="review_number"
                                readonly="1"/>

                        </h1>

                    </div>

                    <!-- ======================================
                         General Information
                    ======================================= -->

                    <group>

                        <group>

                            <field
                                name="applicant_id"
                                options="{'no_open': False}"/>

                            <field
                                name="committee_id"/>

                            <field
                                name="committee_member_id"
                                domain="[('committee_id','=',committee_id)]"/>

                            <field
                                name="meeting_id"/>

                        </group>

                        <group>

                            <field
                                name="recommendation"/>

                            <field
                                name="score"/>

                            <field
                                name="decision_date"
                                readonly="1"/>

                            <field
                                name="approved_by_id"
                                readonly="1"/>

                        </group>

                    </group>

                    <!-- ======================================
                         Notebook
                    ======================================= -->

                    <notebook>

                        <!-- ==================================
                             General
                        =================================== -->

                        <page string="General">

                            <group>

                                <group>

                                    <field
                                        name="applicant_partner_id"
                                        readonly="1"/>

                                    <field
                                        name="applicant_email"
                                        readonly="1"/>

                                    <field
                                        name="applicant_mobile"
                                        readonly="1"/>

                                </group>

                                <group>

                                    <field
                                        name="committee_chairperson_id"
                                        readonly="1"/>

                                    <field
                                        name="committee_secretary_id"
                                        readonly="1"/>

                                </group>

                            </group>

                        </page>

                        <!-- ==================================
                             Interview
                        =================================== -->

                        <page string="Interview">

                            <group>

                                <group>

                                    <field
                                        name="interview_start"/>

                                    <field
                                        name="interview_end"/>

                                    <field
                                        name="interview_location"/>

                                </group>

                                <group>

                                    <field
                                        name="calendar_event_id"
                                        readonly="1"/>

                                    <field
                                        name="meeting_id"/>

                                </group>

                            </group>

                        </page>
                                                <!-- ==================================
                             Committee
                        =================================== -->

                        <page string="Committee">

                            <group>

                                <group>

                                    <field
                                        name="committee_id"
                                        readonly="1"/>

                                    <field
                                        name="committee_member_id"/>

                                    <field
                                        name="committee_chairperson_id"
                                        readonly="1"/>

                                    <field
                                        name="committee_secretary_id"
                                        readonly="1"/>

                                </group>

                                <group>

                                    <field
                                        name="recommendation"/>

                                    <field
                                        name="score"/>

                                    <field
                                        name="status"
                                        widget="badge"/>

                                </group>

                            </group>

                        </page>

                        <!-- ==================================
                             Meeting
                        =================================== -->

                        <page string="Meeting">

                            <group>

                                <group>

                                    <field
                                        name="meeting_id"/>

                                    <field
                                        name="calendar_event_id"
                                        readonly="1"/>

                                </group>

                                <group>

                                    <button
                                        name="action_view_meeting"
                                        type="object"
                                        string="Open Meeting"
                                        class="btn-secondary"
                                        icon="fa-users"/>

                                    <button
                                        name="action_view_calendar_event"
                                        type="object"
                                        string="Open Calendar Event"
                                        class="btn-secondary"
                                        icon="fa-calendar"/>

                                </group>

                            </group>

                        </page>

                        <!-- ==================================
                             Remarks
                        =================================== -->

                        <page string="Remarks">

                            <field
                                name="remarks"
                                nolabel="1"
                                placeholder="Committee remarks, interview observations and recommendations..."/>

                        </page>

                        <!-- ==================================
                             Approval History
                        =================================== -->

                        <page string="Approval">

                            <group>

                                <group>

                                    <field
                                        name="approved_by_id"
                                        readonly="1"/>

                                    <field
                                        name="decision_date"
                                        readonly="1"/>

                                </group>

                                <group>

                                    <field
                                        name="status"
                                        readonly="1"/>

                                    <field
                                        name="recommendation"
                                        readonly="1"/>

                                </group>

                            </group>

                        </page>

                    </notebook>

                </sheet>

                <!-- ==========================================
                     Chatter
                =========================================== -->

                <chatter>

                    <field name="message_follower_ids"/>

                    <field name="activity_ids"/>

                    <field name="message_ids"/>

                </chatter>

            </form>

        </field>

    </record>
        <!-- ==========================================================
         Calendar View
    =========================================================== -->

    <record id="view_club_review_calendar"
            model="ir.ui.view">

        <field name="name">club.review.calendar</field>

        <field name="model">club.review</field>

        <field name="arch" type="xml">

            <calendar
                string="Interview Schedule"
                date_start="interview_start"
                date_stop="interview_end"
                color="committee_id"
                mode="month"
                event_open_popup="false">

                <field name="review_number"/>

                <field name="applicant_id"/>

                <field name="committee_id"/>

                <field name="committee_member_id"/>

                <field name="status"/>

                <field name="recommendation"/>

                <field name="meeting_id"/>

            </calendar>

        </field>

    </record>


    <!-- ==========================================================
         Search View
    =========================================================== -->

    <record id="view_club_review_search"
            model="ir.ui.view">

        <field name="name">club.review.search</field>

        <field name="model">club.review</field>

        <field name="arch" type="xml">

            <search string="Membership Reviews">

                <!-- Search -->

                <field name="review_number"/>

                <field name="applicant_id"/>

                <field name="committee_id"/>

                <field name="committee_member_id"/>

                <field name="interview_start"/>

                <field name="status"/>

                <field name="recommendation"/>

                <separator/>

                <!-- Filters -->

                <filter
                    name="pending"
                    string="Pending"
                    domain="[('status','=','under_review')]"/>

                <filter
                    name="scheduled"
                    string="Scheduled"
                    domain="[('status','=','scheduled')]"/>

                <filter
                    name="completed"
                    string="Interview Completed"
                    domain="[('status','=','interview_completed')]"/>

                <filter
                    name="approved"
                    string="Approved"
                    domain="[('status','=','approved')]"/>

                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('status','=','rejected')]"/>

                <filter
                    name="returned"
                    string="Returned"
                    domain="[('status','=','returned')]"/>

                <separator/>

                <filter
                    name="today"
                    string="Interview Today"
                    domain="[
                        ('interview_start','&gt;=',context_today()),
                        ('interview_start','&lt;',context_today()+relativedelta(days=1))
                    ]"/>

                <separator/>

                <!-- Group By -->

                <group
                    expand="0"
                    string="Group By">

                    <filter
                        name="group_committee"
                        string="Committee"
                        context="{'group_by':'committee_id'}"/>

                    <filter
                        name="group_status"
                        string="Status"
                        context="{'group_by':'status'}"/>

                    <filter
                        name="group_interview"
                        string="Interview Date"
                        context="{'group_by':'interview_start:day'}"/>

                    <filter
                        name="group_chairperson"
                        string="Chairperson"
                        context="{'group_by':'committee_chairperson_id'}"/>

                </group>

            </search>

        </field>

    </record>


    <!-- ==========================================================
         Window Action
    =========================================================== -->

    <record id="action_club_review"
            model="ir.actions.act_window">

        <field name="name">
            Membership Reviews
        </field>

        <field name="res_model">
            club.review
        </field>

        <field name="view_mode">
            list,kanban,calendar,form
        </field>

        <field
            name="search_view_id"
            ref="view_club_review_search"/>

        <field name="context">
            {
                'search_default_pending': 1
            }
        </field>

        <field name="help"
               type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first membership review.
            </p>

            <p>

                Manage applicant interviews,
                committee meetings,
                recommendations,
                approvals,
                and review history.

            </p>

        </field>

    </record>

</odoo>