<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==========================================================
         Committee List View
    =========================================================== -->

    <record id="view_club_committee_list" model="ir.ui.view">
        <field name="name">club.committee.list</field>
        <field name="model">club.committee</field>
        <field name="arch" type="xml">

            <list
                string="Committees"
                create="1"
                edit="1"
                delete="0"
                default_order="name">

                <field name="name"/>

                <field name="chairperson_id"/>

                <field name="secretary_id"/>

                <field name="meeting_frequency"/>

                <field name="meeting_count"/>

                <field name="review_count"/>

                <field name="applicant_count"/>

                <field name="active"/>

            </list>

        </field>
    </record>


    <!-- ==========================================================
         Committee Form View
    =========================================================== -->

    <record id="view_club_committee_form" model="ir.ui.view">
        <field name="name">club.committee.form</field>
        <field name="model">club.committee</field>
        <field name="arch" type="xml">

            <form string="Committee">

                <header>

                    <field
                        name="active"
                        widget="boolean_toggle"/>

                </header>

                <sheet>

                    <!-- =======================================
                         Smart Buttons
                    ======================================== -->

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_view_meetings"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar">

                            <field
                                name="meeting_count"
                                widget="statinfo"
                                string="Meetings"/>

                        </button>

                        <button
                            name="action_view_reviews"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-check-square-o">

                            <field
                                name="review_count"
                                widget="statinfo"
                                string="Reviews"/>

                        </button>

                        <button
                            name="action_view_applicants"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users">

                            <field
                                name="applicant_count"
                                widget="statinfo"
                                string="Applicants"/>

                        </button>

                    </div>

                    <!-- =======================================
                         Title
                    ======================================== -->

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>

                            <field
                                name="name"
                                placeholder="Membership Committee"/>

                        </h1>

                    </div>

                    <!-- =======================================
                         Main Information
                    ======================================== -->

                    <group>

                        <group>

                            <field name="chairperson_id"/>

                            <field name="secretary_id"/>

                            <field name="meeting_frequency"/>

                            <field name="active"/>

                        </group>

                        <group>

                            <field
                                name="meeting_count"
                                readonly="1"/>

                            <field
                                name="review_count"
                                readonly="1"/>

                            <field
                                name="applicant_count"
                                readonly="1"/>

                        </group>

                    </group>

                    <!-- =======================================
                         Notebook
                    ======================================== -->

                    <notebook>

                        <!-- ===============================
                             General
                        ================================ -->

                        <page string="General">

                            <group>

                                <field
                                    name="description"
                                    nolabel="1"
                                    placeholder="Committee description..."/>

                            </group>

                        </page>

                        <!-- ===============================
                             Committee Members
                        ================================ -->

                        <page string="Committee Members">

                            <field
                                name="member_ids"
                                mode="list,form">

                                <list
                                    editable="bottom"
                                    create="0"
                                    delete="0">

                                    <field name="name"/>

                                    <field name="designation"/>

                                    <field name="role"/>

                                    <field name="email"/>

                                    <field name="mobile"/>

                                </list>

                            </field>

                        </page>

                        <!-- ===============================
                             Meetings
                        ================================ -->

                        <page string="Meetings">

                            <field
                                name="meeting_ids"
                                readonly="1"
                                mode="list,form">

                                <list
                                    create="0"
                                    delete="0">

                                    <field name="meeting_number"/>

                                    <field name="meeting_date"/>

                                    <field name="start_datetime"/>

                                    <field name="location"/>

                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                        <!-- ===============================
                             Membership Reviews
                        ================================ -->

                        <page string="Membership Reviews">

                            <field
                                name="review_ids"
                                readonly="1"
                                mode="list,form">

                                <list
                                    create="0"
                                    delete="0">

                                    <field name="review_number"/>

                                    <field name="applicant_id"/>

                                    <field name="interview_start"/>

                                    <field name="recommendation"/>

                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                        <!-- ===============================
                             Chatter
                        ================================ -->

                        <page string="Chatter">

                            <group>

                                <field
                                    name="activity_ids"
                                    widget="mail_activity"/>

                            </group>

                        </page>

                    </notebook>

                </sheet>

                <!-- =======================================
                     Chatter
                ======================================== -->

                <chatter>

                    <field name="message_follower_ids"/>

                    <field name="activity_ids"/>

                    <field name="message_ids"/>

                </chatter>

            </form>

        </field>

    </record>

    <!-- ==========================================================
         Search View
    =========================================================== -->

    <record id="view_club_committee_search" model="ir.ui.view">
        <field name="name">club.committee.search</field>
        <field name="model">club.committee</field>
        <field name="arch" type="xml">

            <search string="Committees">

                <field name="name"/>

                <field name="chairperson_id"/>

                <field name="secretary_id"/>

                <field name="meeting_frequency"/>

                <separator/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active','=',True)]"/>

                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]"/>

                <separator/>

                <group expand="0" string="Group By">

                    <filter
                        name="group_frequency"
                        string="Meeting Frequency"
                        context="{'group_by':'meeting_frequency'}"/>

                    <filter
                        name="group_chairperson"
                        string="Chairperson"
                        context="{'group_by':'chairperson_id'}"/>

                    <filter
                        name="group_secretary"
                        string="Secretary"
                        context="{'group_by':'secretary_id'}"/>

                </group>

            </search>

        </field>

    </record>

    <!-- ==========================================================
         Window Action
    =========================================================== -->

    <record id="action_club_committee" model="ir.actions.act_window">

        <field name="name">Committees</field>

        <field name="res_model">club.committee</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_club_committee_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first committee.
            </p>

            <p>
                Manage committee members, meetings,
                membership reviews and interview activities.
            </p>

        </field>

    </record>

</odoo>
