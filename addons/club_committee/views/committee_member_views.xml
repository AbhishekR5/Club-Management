<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==========================================================
         Committee Member List View
    =========================================================== -->

    <record id="view_club_committee_member_list" model="ir.ui.view">
        <field name="name">club.committee.member.list</field>
        <field name="model">club.committee.member</field>
        <field name="arch" type="xml">

            <list
                string="Committee Members"
                create="1"
                edit="1"
                delete="0"
                default_order="committee_id,name">

                <field name="name"/>

                <field name="committee_id"/>

                <field name="role"/>

                <field name="designation"/>

                <field name="email"/>

                <field name="mobile"/>

                <field name="review_count"/>

                <field name="active"/>

            </list>

        </field>
    </record>


    <!-- ==========================================================
         Committee Member Form View
    =========================================================== -->

    <record id="view_club_committee_member_form" model="ir.ui.view">
        <field name="name">club.committee.member.form</field>
        <field name="model">club.committee.member</field>
        <field name="arch" type="xml">

            <form string="Committee Member">

                <header>

                    <field
                        name="active"
                        widget="boolean_toggle"/>

                </header>

                <sheet>

                    <!-- Smart Button -->

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_view_reviews"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-check-square">

                            <field
                                name="review_count"
                                widget="statinfo"
                                string="Reviews"/>

                        </button>

                    </div>

                    <div class="oe_title">

                        <label for="partner_id"/>

                        <h1>

                            <field
                                name="partner_id"
                                options="{'no_create': False}"/>

                        </h1>

                    </div>

                    <group>

                        <group>

                            <field name="committee_id"/>

                            <field name="role"/>

                            <field name="user_id"/>

                            <field name="active"/>

                        </group>

                        <group>

                            <field
                                name="designation"
                                readonly="1"/>

                            <field
                                name="email"
                                readonly="1"/>

                            <field
                                name="phone"
                                readonly="1"/>

                            <field
                                name="mobile"
                                readonly="1"/>

                        </group>

                    </group>

                    <notebook>

                        <!-- =======================================
                             Contact Information
                        ======================================== -->

                        <page string="Contact">

                            <group>

                                <field
                                    name="partner_id"
                                    readonly="1"/>

                                <field
                                    name="designation"
                                    readonly="1"/>

                                <field
                                    name="email"
                                    readonly="1"/>

                                <field
                                    name="phone"
                                    readonly="1"/>

                                <field
                                    name="mobile"
                                    readonly="1"/>

                            </group>

                        </page>

                        <!-- =======================================
                             Reviews
                        ======================================== -->

                        <page string="Assigned Reviews">

                            <field
                                name="review_ids"
                                readonly="1"
                                mode="list,form">

                                <list
                                    create="0"
                                    delete="0">

                                    <field name="review_number"/>

                                    <field name="applicant_id"/>

                                    <field name="committee_id"/>

                                    <field name="interview_start"/>

                                    <field name="recommendation"/>

                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter>

                    <field name="message_follower_ids"/>

                    <field name="activity_ids"/>

                    <field name="message_ids"/>

                </chatter>

            </form>

        </field>
    </record>


    <!-- ==========================================================
         Search View
    =========================================================== -->

    <record id="view_club_committee_member_search"
            model="ir.ui.view">

        <field name="name">
            club.committee.member.search
        </field>

        <field name="model">
            club.committee.member
        </field>

        <field name="arch" type="xml">

            <search string="Committee Members">

                <field name="name"/>

                <field name="committee_id"/>

                <field name="role"/>

                <field name="designation"/>

                <separator/>

                <filter
                    name="chairperson"
                    string="Chairperson"
                    domain="[('role','=','chairperson')]"/>

                <filter
                    name="secretary"
                    string="Secretary"
                    domain="[('role','=','secretary')]"/>

                <filter
                    name="member"
                    string="Member"
                    domain="[('role','=','member')]"/>

                <separator/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active','=',True)]"/>

                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]"/>

                <separator/>

                <group expand="0" string="Group By">

                    <filter
                        name="group_committee"
                        string="Committee"
                        context="{'group_by':'committee_id'}"/>

                    <filter
                        name="group_role"
                        string="Role"
                        context="{'group_by':'role'}"/>

                </group>

            </search>

        </field>

    </record>


    <!-- ==========================================================
         Window Action
    =========================================================== -->

    <record id="action_club_committee_member"
            model="ir.actions.act_window">

        <field name="name">
            Committee Members
        </field>

        <field name="res_model">
            club.committee.member
        </field>

        <field name="view_mode">
            list,form
        </field>

        <field
            name="search_view_id"
            ref="view_club_committee_member_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first committee member.
            </p>

            <p>
                Assign contacts to committees, define their
                roles, and manage committee responsibilities.
            </p>

        </field>

    </record>

</odoo>