<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         Samruddhi Eco System — Page Templates
         ════════════════════════════════════════════════════════════════

         Inner-page templates rendered by controllers.
         Homepage is in homepage.xml (separate file).
         Each page calls website.layout and receives page_class
         from the controller for CSS scoping.
         ════════════════════════════════════════════════════════════════ -->


    <!-- ── About Page ────────────────────────────────────────────────── -->

    <template id="page_about" name="Samruddhi Eco System — About">
        <t t-call="website.layout">
            <t t-set="additional_title">About — Samruddhi Eco System</t>

            <main id="se-wrap" t-attf-class="se-page #{page_class}" role="main">
                <section id="se-page-about" aria-labelledby="se-page-about-title">
                    <div class="se-container">
                        <header>
                            <p>About Us</p>
                            <h1 id="se-page-about-title">The Story Behind Samruddhi</h1>
                            <p>
                                This page is under construction. We are crafting
                                an immersive story experience. Stay tuned.
                            </p>
                        </header>
                    </div>
                </section>
            </main>
        </t>
    </template>


