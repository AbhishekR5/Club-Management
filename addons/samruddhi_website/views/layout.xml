<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         Samruddhi Eco System — Master Layout
         ════════════════════════════════════════════════════════════════

         Inherits website.layout to inject:
           • SEO meta tags (viewport, charset, description, OG, Twitter)
           • Google Fonts preconnect hints
           • Body classes for page-level CSS scoping
           • Custom cinematic navigation bar
           • Custom premium footer

         No inline CSS. No inline JavaScript.
         All styling via SCSS assets. All logic via JS assets.
         ════════════════════════════════════════════════════════════════ -->


    <!-- ── SEO Meta Tags & Font Preconnect ───────────────────────────
         Injected into <head> of every website page.
         ────────────────────────────────────────────────────────────── -->

    <template id="layout_head_meta"
              name="Samruddhi — Head Meta"
              inherit_id="website.layout"
              priority="20">

        <xpath expr="//head" position="inside">
            <!-- Responsive viewport -->
            <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>

            <!-- SEO defaults (overridable per-page via t-set) -->
            <meta name="description">
                <t t-if="meta_description">
                    <t t-att-content="meta_description"/>
                </t>
                <t t-else="">
                    <t t-att-content="'Samruddhi Eco System — A premium community ecosystem where lifestyle meets legacy. Club, wellness, education, and nature.'"/>
                </t>
            </meta>
            <meta name="author" content="Samruddhi Avenue Club"/>
            <meta name="theme-color" content="#0a0a0f"/>

            <!-- Open Graph -->
            <meta property="og:type" content="website"/>
            <meta property="og:site_name" content="Samruddhi Eco System"/>
            <meta property="og:title">
                <t t-att-content="additional_title or 'Samruddhi Eco System'"/>
            </meta>
            <meta property="og:description">
                <t t-if="meta_description" t-att-content="meta_description"/>
                <t t-else="" t-att-content="'A premium community ecosystem where lifestyle meets legacy.'"/>
            </meta>
            <meta property="og:image" t-att-content="'/samruddhi_website/static/src/img/og_image.jpg'"/>

            <!-- Twitter Card -->
            <meta name="twitter:card" content="summary_large_image"/>
            <meta name="twitter:title">
                <t t-att-content="additional_title or 'Samruddhi Eco System'"/>
            </meta>

            <!-- Google Fonts Preconnect (actual @import in 001_fonts.scss asset) -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
        </xpath>
    </template>


    <!-- ── Body Class Injection ───────────────────────────────────────
         Adds 'se-body' to <body> for global CSS scoping without
         affecting the Odoo backend.
         ────────────────────────────────────────────────────────────── -->

    <template id="layout_body_class"
              name="Samruddhi — Body Class"
              inherit_id="website.layout"
              priority="20">

        <xpath expr="//body" position="attributes">
            <attribute name="t-attf-class"
                       add="se-body"
                       separator=" "/>
        </xpath>
    </template>


    <!-- ── Custom Navigation Header ──────────────────────────────────
         Replaces the default Odoo website header content with
         a premium cinematic navigation bar.

         Structure:
           <header.se-header>
             └ <nav.se-nav>
                 ├ Brand (logo / text)
                 ├ Mobile toggle
                 └ Nav links (auto from website.menu)
         ────────────────────────────────────────────────────────────── -->

    <template id="layout_header"
              name="Samruddhi — Header"
              inherit_id="website.layout"
              priority="20">

        <xpath expr="//header//nav" position="replace">
            <nav class="se-nav navbar navbar-expand-lg" role="navigation"
                 aria-label="Main navigation" itemscope=""
                 itemtype="http://schema.org/SiteNavigationElement">

                <div class="se-container se-nav__inner">

                    <!-- Brand -->
                    <a class="navbar-brand se-nav__brand" href="/"
                       aria-label="Samruddhi Eco System — Home">
                        <span class="se-nav__brand-text">Samruddhi</span>
                        <span class="se-nav__brand-accent">Eco System</span>
                    </a>

                    <!-- Mobile Toggle -->
                    <button class="navbar-toggler se-nav__toggle"
                            type="button"
                            aria-controls="se-nav-collapse"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Navigation Links -->
                    <div class="collapse navbar-collapse se-nav__collapse"
                         id="se-nav-collapse">
                        <ul class="navbar-nav ms-auto se-nav__list">
                            <li class="nav-item">
                                <a class="nav-link" href="/">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/about">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/ecosystem">Ecosystem</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/membership">Membership</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/projects">Projects</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/contact">Contact</a>
                            </li>
                        </ul>
                    </div>

                </div>
            </nav>
        </xpath>
    </template>


    <!-- ── Custom Footer ─────────────────────────────────────────────
         Replaces the default Odoo website footer with a premium
         dark footer containing brand, navigation columns, social
         links, and copyright bar.
         ────────────────────────────────────────────────────────────── -->

    <template id="layout_footer"
              name="Samruddhi — Footer"
              inherit_id="website.layout"
              priority="20">

        <xpath expr="//footer" position="replace">
            <footer id="footer" class="se-footer" role="contentinfo"
                    itemscope="" itemtype="http://schema.org/WPFooter">
                <div class="se-container">

                    <!-- Footer Grid -->
                    <div class="se-footer__grid">

                        <!-- Brand Column -->
                        <div class="se-footer__brand">
                            <div class="se-footer__logo">
                                Samruddhi<br/>
                                <span class="text-gradient">Eco System</span>
                            </div>
                            <p class="se-footer__desc">
                                Building a thriving community where lifestyle
                                meets legacy. A premium ecosystem designed
                                for the extraordinary.
                            </p>
                            <div class="se-footer__social">
                                <a href="#" class="se-footer__social-link"
                                   aria-label="Facebook">
                                    <i class="fa fa-facebook"></i>
                                </a>
                                <a href="#" class="se-footer__social-link"
                                   aria-label="Instagram">
                                    <i class="fa fa-instagram"></i>
                                </a>
                                <a href="#" class="se-footer__social-link"
                                   aria-label="LinkedIn">
                                    <i class="fa fa-linkedin"></i>
                                </a>
                                <a href="#" class="se-footer__social-link"
                                   aria-label="YouTube">
                                    <i class="fa fa-youtube-play"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Quick Links Column -->
                        <div class="se-footer__col">
                            <h4 class="se-footer__heading">Quick Links</h4>
                            <ul class="se-footer__links">
                                <li><a href="/">Home</a></li>
                                <li><a href="/about">About</a></li>
                                <li><a href="/ecosystem">Ecosystem</a></li>
                                <li><a href="/projects">Projects</a></li>
                            </ul>
                        </div>

                        <!-- Membership Column -->
                        <div class="se-footer__col">
                            <h4 class="se-footer__heading">Membership</h4>
                            <ul class="se-footer__links">
                                <li><a href="/membership">Join Us</a></li>
                                <li><a href="/membership">Benefits</a></li>
                                <li><a href="/membership">Tiers</a></li>
                                <li><a href="/contact">Enquiry</a></li>
                            </ul>
                        </div>

                        <!-- Contact Column -->
                        <div class="se-footer__col">
                            <h4 class="se-footer__heading">Contact</h4>
                            <ul class="se-footer__links">
                                <li><a href="/contact">Get in Touch</a></li>
                                <li><a href="/contact">Location</a></li>
                                <li><a href="/contact">Support</a></li>
                            </ul>
                        </div>

                    </div>

                    <!-- Bottom Bar -->
                    <div class="se-footer__bottom">
                        <p class="se-footer__copyright">
                            © <t t-esc="datetime.date.today().year"/>
                            Samruddhi Eco System. All rights reserved.
                        </p>
                        <div class="se-footer__bottom-links">
                            <a href="/privacy">Privacy Policy</a>
                            <a href="/terms">Terms of Service</a>
                        </div>
                    </div>

                </div>
            </footer>
        </xpath>
    </template>

</odoo>
