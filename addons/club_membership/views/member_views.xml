<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- List View -->
    <!-- ========================================================= -->
    <record id="view_club_member_list" model="ir.ui.view">
        <field name="name">club.member.list</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="image_1920" widget="image" optional="show"/>
                <field name="member_id"/>
                <field name="name"/>
                <field name="membership_tier_id"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="joining_date"/>
                <field name="expiry_date"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status in ('expired','cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Search View -->
    <!-- ========================================================= -->
    <record id="view_club_member_search" model="ir.ui.view">
        <field name="name">club.member.search</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <search string="Members">
                <field name="name"/>
                <field name="active"/>
            </search>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Kanban View -->
    <!-- ========================================================= -->
    <record id="view_club_member_kanban" model="ir.ui.view">
        <field name="name">club.member.kanban</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="image_1920"/>
                <field name="member_id"/>
                <field name="name"/>
                <field name="membership_tier_id"/>
                <field name="status"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="text-center mb-3">
                                <field name="image_1920" widget="image" class="oe_avatar"/>
                            </div>

                            <div class="fw-bold fs-5 text-center">
                                <field name="name"/>
                            </div>

                            <div class="text-center text-muted">
                                <field name="member_id"/>
                            </div>

                            <div class="text-center mt-2">
                                <field name="membership_tier_id"/>
                            </div>

                            <div class="text-center mt-2">
                                <field name="status" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Form View -->
    <!-- ========================================================= -->
    <record id="view_club_member_form" model="ir.ui.view">
        <field name="name">club.member.form</field>
        <field name="model">club.member</field>
        <field name="arch" type="xml">
            <form string="Club Member">

                <header>

                    <button name="action_activate"
                            type="object"
                            string="Activate"
                            class="btn-primary"/>

                    <button name="action_suspend"
                            type="object"
                            string="Suspend"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,pending,active,suspended,expired,cancelled"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_family_members"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">

                            <field name="family_member_count"
                                   widget="statinfo"
                                   string="Family Members"/>

                        </button>

                    </div>

                    <group>

                        <group>

                            <field name="image_1920" widget="image" class="oe_avatar"/>

                            <field name="member_id" readonly="1"/>

                            <field name="partner_id"/>

                            <field name="name"/>

                            <field name="membership_tier_id"/>

                        </group>

                        <group>

                            <field name="mobile"/>

                            <field name="email"/>

                            <field name="date_of_birth"/>

                            <field name="gender"/>

                            <field name="blood_group"/>

                            <field name="occupation"/>

                            <field name="company"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="General Information">

                            <group>

                                <group>

                                    <field name="street"/>

                                    <field name="street2"/>

                                    <field name="city"/>

                                </group>

                                <group>

                                    <field name="state_id"/>

                                    <field name="country_id"/>

                                    <field name="zip"/>

                                </group>

                            </group>

                        </page>

                        <page string="Membership">

                            <group>

                                <group>

                                    <field name="joining_date"/>

                                    <field name="expiry_date"/>

                                </group>

                            </group>

                        </page>

                        <page string="Family Members">

                            <field name="family_member_ids">

                                <list editable="bottom">

                                    <field name="name"/>

                                    <field name="relation"/>

                                    <field name="date_of_birth"/>

                                    <field name="phone"/>

                                    <field name="email"/>

                                </list>

                            </field>

                        </page>

                        <page string="Internal Notes">

                            <field name="notes" nolabel="1"/>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Action -->
    <!-- ========================================================= -->
    <record id="action_club_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">club.member</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_club_member_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first club member.
            </p>
        </field>
    </record>

</odoo>