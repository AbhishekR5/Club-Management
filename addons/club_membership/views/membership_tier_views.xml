<?xml version="1.0" encoding="UTF-8"?>
<odoo>


        <!-- ========================================================= -->
        <!-- List View -->
        <!-- ========================================================= -->

        <record id="view_club_membership_tier_list" model="ir.ui.view">
            <field name="name">club.membership.tier.list</field>
            <field name="model">club.membership.tier</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <list string="Membership Tiers" default_order="sequence">

                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="joining_fee"/>
                    <field name="annual_renewal_fee"/>
                    <field name="member_count"/>
                    <field name="active"/>

                </list>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- Form View -->
        <!-- ========================================================= -->

        <record id="view_club_membership_tier_form" model="ir.ui.view">
            <field name="name">club.membership.tier.form</field>
            <field name="model">club.membership.tier</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">

                <form string="Membership Tier">

                    <header>
                        <field name="active" widget="boolean_toggle"/>
                    </header>

                    <sheet>

                        <div class="oe_button_box" name="button_box">

                            <button
                                name="action_view_members"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">

                                <field
                                    name="member_count"
                                    widget="statinfo"
                                    string="Members"/>

                            </button>

                        </div>

                        <group>

                            <group>

                                <field name="name"/>

                                <field name="sequence"/>

                                <field name="active"/>

                            </group>

                            <group>

                                <field name="joining_fee"/>

                                <field name="annual_renewal_fee"/>

                                <field
                                    name="currency_id"
                                    groups="base.group_multi_currency"/>

                            </group>

                        </group>

                        <notebook>

                            <page string="Description">

                                <field
                                    name="description"
                                    nolabel="1"/>

                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>

                </form>

            </field>
        </record>

        <!-- ========================================================= -->
        <!-- Kanban View -->
        <!-- ========================================================= -->

        <record id="view_club_membership_tier_kanban" model="ir.ui.view">
            <field name="name">club.membership.tier.kanban</field>
            <field name="model">club.membership.tier</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">

                <kanban>

                    <field name="name"/>
                    <field name="joining_fee"/>
                    <field name="annual_renewal_fee"/>
                    <field name="member_count"/>
                    <field name="active"/>

                    <templates>

                        <t t-name="kanban-box">

                            <div class="oe_kanban_global_click p-3">

                                <div class="fw-bold fs-5 mb-2">
                                    <field name="name"/>
                                </div>

                                <div>
                                    <strong>Joining Fee:</strong>
                                    <field name="joining_fee"/>
                                </div>

                                <div>
                                    <strong>Renewal Fee:</strong>
                                    <field name="annual_renewal_fee"/>
                                </div>

                                <div class="mt-2">
                                    <strong>Members:</strong>
                                    <field name="member_count"/>
                                </div>

                                <div class="mt-2">
                                    <field
                                        name="active"
                                        widget="boolean_toggle"/>
                                </div>

                            </div>

                        </t>

                    </templates>

                </kanban>

            </field>
        </record>

        <!-- ========================================================= -->
        <!-- Search View -->
        <!-- ========================================================= -->

        <record id="view_club_membership_tier_search" model="ir.ui.view">
            <field name="name">club.membership.tier.search</field>
            <field name="model">club.membership.tier</field>
            <field name="arch" type="xml">

                <search string="Membership Tiers">

                    <field name="name"/>

                    <filter
                        name="active"
                        string="Active"
                        domain="[('active', '=', True)]"/>

                    <filter
                        name="inactive"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                    <group expand="0" string="Group By">

                        <filter
                            name="group_active"
                            string="Status"
                            context="{'group_by':'active'}"/>

                    </group>

                </search>

            </field>
        </record>

        <!-- ========================================================= -->
        <!-- Action -->
        <!-- ========================================================= -->

        <record id="action_membership_tier" model="ir.actions.act_window">

            <field name="name">Membership Tiers</field>

            <field name="res_model">club.membership.tier</field>

            <field name="view_mode">list,form,kanban</field>

            <field
                name="search_view_id"
                ref="view_club_membership_tier_search"/>

            <field name="help" type="html">

                <p class="o_view_nocontent_smiling_face">
                    Create your first membership tier.
                </p>

            </field>

        </record>


</odoo>